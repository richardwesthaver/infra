 (tree-sitter (src)
  (:clone (src) (vc-clone ".stash/src/tree-sitter" "https://github.com/tree-sitter/tree-sitter"))
  (:build (clone-tree-sitter) #$cd .stash/src/tree-sitter && make libtree-sitter.so$#)
