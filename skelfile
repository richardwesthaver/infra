((check () (print-table (check-host)))
 (upstream ()
  (with-directory "/tmp"
   (delete-directories '("infra" "home" "pod" "box")))
  (labels ((add-remotes (repo name)
            (vc-remote repo :add :name "cb" :url (format nil "ssh://git@codeberg.org/c-c/~A" name))
            (vc-remote repo :add :name "gh" :url (format nil "ssh://git@github.com/richardwesthaver/~A" name)))
           (push-upstream (repo &optional force)
            (vc-push repo :set-upstream t :remote "cb" :all t :force force)
            (vc-push repo :remote "gh" :all t :force force))
           (bump (name)
            (let ((tmp (directory-path (merge-pathnames name "/tmp/"))))
             (vc-export (vc *skel-project*) tmp)
             (with-repo (r :type :git :path tmp)
              (add-remotes r name)
              (push-upstream r t)))))
   (bump "home")
   (bump "pod")
   (bump "box")
   (vc-export (vc *skel-project*) (merge-pathnames (name *skel-project*) "/tmp/"))
   (with-repo (r :type :git :path "/tmp/infra/")
    (add-remotes r "infra")
    (vc-update r)
    (vc-submodule r :add :url "https://github.com/richardwesthaver/home")
    (vc-submodule r :add :url "https://github.com/richardwesthaver/pod")
    (vc-submodule r :add :url "https://github.com/richardwesthaver/box")
    (vc-add r ".gitmodules")
    (vc-commit r "gitmodules")
    (push-upstream r t))))
 (clean () 
  (delete-directory ".stash" :recursive t)
  (mapc 'delete-file (directory "**/*.fasl")))
 (readme ()
  (:update ()
   (with-emacs (e)
    (org-babel-lob-ingest company-babel-file)
    (org-with-file-buffer (join-paths company-source-directory "infra/readme.org")
     (org-babel-execute-buffer)
     (save-buffer)))))
 (tmp () (ensure-directories-exist ".stash/tmp"))
 (src () (ensure-directories-exist ".stash/src"))
 (bin () (ensure-directories-exist ".stash/bin"))
;;; src
 (home (src) #$hg clone $VC_URL/home .stash/src/home$#)
 (core (src) 
  (:build () #$hg clone $VC_URL/core .stash/src/core$#)
  (:install-pack (tmp) (with-sudo "-E scripts/install-core-pack.sh"))
  (:install (tmp) (with-sudo "-E scripts/install-core.sh")))
;;; programs
 (emacs ()
  (:clone (src) 
   (vc-clone ".stash/src/emacs" "https://github.com/emacs-mirror/emacs"))
  (:build (clone-emacs)
   (build-emacs))
  (:build-mini (clone-emacs)
   (build-emacs 
    :without-all t 
    :with-x-toolkit "no" 
    :without-x t 
    :with-imagemagick nil
    :with-tree-sitter nil))
  (:install () (with-sudo "make install -C stash/src/emacs/"))
  (:install-pack (tmp) (with-sudo "-E scripts/install-emacs-pack.sh"))
  (:update () (with-repo (r :path ".stash/src/emacs" :type :git) (vc-pull r)))
  (:dist-mini () 
   (with-directory ".stash/src/emacs"
   (run-program *shell* '("./make-dist" "--tar" "--no-compress" "--no-info" "--no-changelog"))
   #$zstd -8 emacs-31.0.50.tar -o "../../emacs-mini.tar.zst"$#))
  (:dist () 
   (with-directory ".stash/src/emacs"
    (run-program *shell* '("./make-dist" "--tar" "--no-compress"))
    #$zstd -8 emacs-31.0.50.tar -o "../../emacs.tar.zst"$#)))
 (rocksdb ()
  (:clone (src) (vc-clone ".stash/src/rocksdb" "https://github.com/facebook/rocksdb"))
  (:build (clone-rocksdb) #$cd .stash/src/rocksdb && make shared_lib DISABLE_JEMALLOC=1$#)
  (:build-static (clone-rocksdb) #$cd .stash/src/rocksdb && make static_lib DISABLE_JEMALLOC=1$#)
  (:update () #$cd .stash/src/rocksdb && git pull$#)
  (:install () 
   (funcall #0$cd .stash/src/rocksdb \
    && sudo -S make install-shared && \
    sudo cp -r include/* /usr/local/include/$# :input t))
  (:install-pack (tmp)
   (funcall #0$sudo -SE scripts/install-rocksdb-pack.sh$# :input t))
  (:dist () #$scripts/dist-rocksdb-binary.sh$#)
  (:dist-source () #$scripts/dist-rocksdb-source.sh$#))
 (libui ()
  (:clone (src) 
   ;; (vc-clone ".stash/src/libui" "https://github.com/andlabs/libui")
   (vc-clone ".stash/src/libui" "https://github.com/libui-ng/libui-ng"))
  (:build (clone-libui)
   #$cd .stash/src/libui
     meson setup build --buildtype=release --default-library=shared
     ninja -C build$#)
  (:install () 
   (with-directory ".stash/src/libui/"
    (with-sudo "ninja -C build install"))))
 (sbcl ()
  (:clone (src)
   ;; could arrange to checkout specific branch/tag here (lkg)
   (vc-clone ".stash/src/sbcl" "https://github.com/sbcl/sbcl"))
  (:build (clone-sbcl)
   (with-directory ".stash/src/sbcl"
    ;; --with-sb-fasteval --without-sb-eval --xc-host=/usr/local/bin/core
    (run-program "./make.sh" '("--dynamic-space-size=8Gb" "--fancy"))))
  (:build-docs () (with-directory ".stash/src/sbcl/doc/manual" (run-make nil)))
  (:build-gencgc (src) (with-directory ".stash/src/sbcl" (run-program "./make.sh" '("--fancy"))))
  (:build-fasteval (clone-sbcl)
   (with-directory ".stash/src/sbcl"
    (run-program "./make.sh" 
     '("--dynamic-space-size=8Gb" "--without-gencgc" "--with-mark-region-gc" "--fancy"
       "--with-sb-fasteval" "--without-sb-eval"))))
  (:build-shared () (with-directory ".stash/src/sbcl" (run-program *shell* '("make-shared-library.sh"))))
  (:build-all-cores () (with-directory ".stash/src/sbcl" (run-program *shell* '("build-all-cores.sh"))))
  (:update () (with-repo (r :path ".stash/src/sbcl" :type :git) (vc:vc-update r)))
  (:install () 
   (with-directory ".stash/src/sbcl" 
    (with-sudo "INSTALL_ROOT=/usr/local ./install.sh")))
  (:install-src () (with-directory ".stash/src/sbcl" (with-sudo (format nil "cp -rf src contrib ~A/src/sbcl/" (sb-posix:getenv "PREFIX")))))
  (:install-pack (tmp)
   (with-sudo "-E scripts/install-sbcl-pack.sh"))
  (:dist () #$scripts/dist-sbcl-binary.sh$#)
  (:dist-source () #$scripts/dist-sbcl-source.sh$#))
 (install-quicklisp (tmp) (install-quicklisp ".stash/quicklisp.lisp"))
 (stumpwm ()
  (:clone (src) (vc-clone ".stash/src/stumpwm" "https://github.com/richardwesthaver/stumpwm"))
  (:build (clone-stumpwm)
   #$cd .stash/src/stumpwm && ./autogen.sh && ./configure && make$#)
  (:install () (funcall #0$cd .stash/src/stumpwm && sudo -S make install$# :input t))
  (:update () #$cd .stash/src/stumpwm && git pull$#)
  (:dist () #$scripts/dist-stumpwm-binary.sh$#))
