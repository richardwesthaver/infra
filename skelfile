;;; skelfile --- infra skelfile -*- mode: skel; -*-
:name "infra"
:author ("Richard Westhaver" . "richard.westhaver@gmail.com")
:version "0.1.0"
:description "The Compiler Company Infrastructure"
:tags (:infra)
:license "MPL"
:vc (:hg "https://vc.compiler.company/infra")
:include ("pod/skelfile")
:components ((:org "readme")
             (:mod "scripts"))
:bind ((packy-home :env "/opt/core/store/packy")
       (vc-url :env "~/comp")
       (prefix :env "/usr/local")
       (stash :env ".stash")
       (store :env "/opt/core/store")
       (dev :env (or (sb-posix:getenv "USER") "")))
:stash ".stash"
:store "/opt/core/store"
:rules
((check () #$./check.sh$#)
 (upstream ()
           (delete-directories 
            '("/tmp/infra/" "/tmp/home/" "/tmp/pod/" "/tmp/box/" "/tmp/etc/"))
           (vc:hg-fast-export (make-instance 'vc:hg-repo :path (probe-file "home/")))
           #$cd /tmp/home
           git remote add cb ssh://git@codeberg.org/c-c/home
           git remote add gh ssh://git@github.com/richardwesthaver/home
           git push -u cb --all --force
           git push gh --all --force$#
           (vc:hg-fast-export (make-instance 'vc:hg-repo :path (probe-file "pod/")))
           #$cd /tmp/pod
           git remote add cb ssh://git@codeberg.org/c-c/pod
           git remote add gh ssh://git@github.com/richardwesthaver/pod
           git push -u cb --all --force
           git push gh --all --force$#
           (vc:hg-fast-export (make-instance 'vc:hg-repo :path (probe-file "box/")))
           #$cd /tmp/box
           git remote add cb ssh://git@codeberg.org/c-c/box
           git remote add gh ssh://git@github.com/richardwesthaver/box
           git push -u cb --all --force
           git push gh --all --force$#
           (vc:hg-fast-export (make-instance 'vc:hg-repo :path (probe-file "etc/")))
           #$cd /tmp/etc
           git remote add cb ssh://git@codeberg.org/c-c/etc
           git remote add gh ssh://git@github.com/richardwesthaver/etc
           git push -u cb --all --force
           git push gh --all --force$#
           (vc:hg-fast-export (sk-vc *skel-project*))
           #$cd /tmp/infra
           git remote add cb ssh://git@codeberg.org/c-c/infra
           git remote add gh ssh://git@github.com/richardwesthaver/infra
           git checkout
           git submodule add https://github.com/richardwesthaver/home
           git submodule add https://github.com/richardwesthaver/pod
           git submodule add https://github.com/richardwesthaver/box
           git submodule add https://github.com/richardwesthaver/etc
           git add .gitmodules
           git commit -m 'gitmodules'
           git push -u cb --all --force
           git push gh --all --force$#)
 (clean () 
        ;; #,@(mapcar (lambda (x) (make-pathname :name (machine-instance) :type x))
        ;;            '("sxp" "env"))
        #$rm -rvf .stash \
        $#)
 (tmp () #$mkdir -pv .stash/tmp$#)
 (src () #$mkdir -pv .stash/src$#)
 (bin () #$mkdir -pv .stash/bin$#)
 ;; src
 (repos (src tmp) #$cd .stash/tmp && scripts/get.sh $PACKY_HOME/src/comp.tar.zst && \
        unzstd comp.tar.zst && tar -xf comp.tar -C ../src && \
        mv ../src/hg/* ../src/ && rm -rf ../src/hg comp.tar$#)
 (install-repos-shallow (repos) (funcall #$cd .stash/src && sudo -S mv *.hg /usr/local/src/$# :input t))
 (home (src) #$hg clone $VC_URL/home .stash/src/home$#)
 (core (src) 
       (:build () #$hg clone $VC_URL/core .stash/src/core$#)
       (:install-pack (tmp) (funcall #$sudo -SE scripts/install-core-pack.sh$# :input t))
       (:install (tmp) (funcall #$sudo -SE scripts/install-core.sh$# :input t)))
 (packy-repos (src) #$cd .stash/tmp && ../../scripts/get.sh $PACKY_HOME/src/packy.tar.zst && \
              unzstd packy.tar.zst && tar -xf packy.tar -C ../src/ && \
              rm -rf packy.tar$#)
 ;; programs
 (bootstrap () #$./bootstrap.sh$#)
 (emacs ()
        (:clone (src) (vc:vc-clone ".stash/src/emacs" "https://github.com/emacs-mirror/emacs"))
        (:build (clone-emacs) 
                #$cd .stash/src/emacs && ./autogen.sh$#
                #$./scripts/build-emacs.sh$#)
        (:build-mini (clone-emacs) 
                     #$cd .stash/src/emacs && ./autogen.sh$#
                     #$./scripts/build-emacs-mini.sh$#)
        (:install () (funcall #$cd .stash/src/emacs && sudo -S make install$# :input t))
        (:install-pack (tmp)
                       (funcall #$sudo -SE scripts/install-emacs-pack.sh$# :input t))
        (:update () #$cd .stash/src/emacs && git pull$#)
        (:dist-mini () #$cd .stash/src/emacs
                    ./make-dist --tar --no-compress --no-info --no-changelog
                    zstd -8 emacs-31.0.50.tar -o "../../emacs-mini.tar.zst"$#)
        (:dist () #$cd .stash/src/emacs
               ./make-dist --tar --no-compress
               zstd -8 emacs-31.0.50.tar -o "../../emacs.tar.zst"$#))
 (rocksdb ()
          (:clone (src) (vc:vc-clone ".stash/src/rocksdb" "https://github.com/facebook/rocksdb"))
          (:build (clone-rocksdb) #$cd .stash/src/rocksdb && make shared_lib DISABLE_JEMALLOC=1$#)
          (:build-static (clone-rocksdb) #$cd .stash/src/rocksdb && make static_lib DISABLE_JEMALLOC=1$#)
          (:update () #$cd .stash/src/rocksdb && git pull$#)
          (:install () 
                    (funcall #$cd .stash/src/rocksdb \
                             && sudo -S make install-shared && \
                             sudo cp -r include/* /usr/local/include/$# :input t))
          (:install-pack (tmp)
                         (funcall #$sudo -SE scripts/install-rocksdb-pack.sh$# :input t))
          (:dist () #$scripts/dist-rocksdb-binary.sh$#)
          (:dist-source () #$scripts/dist-rocksdb-source.sh$#))
 (sbcl ()
       (:clone (src)
               (vc:vc-clone ".stash/src/sbcl" "https://github.com/sbcl/sbcl"))
       (:build (clone-sbcl)
               #$cd .stash/src/sbcl
               ./make.sh --dynamic-space-size=8Gb --without-gencgc --with-mark-region-gc --fancy \
               # --with-sb-fasteval --without-sb-eval$#)
       (:build-docs () #$cd .stash/src/sbcl/doc/manual && make$#)
       (:build-gencgc (src) #$cd .stash/src/sbcl &&
                      ./make.sh --fancy$#)
       (:build-shared () #$cd .stash/src/sbcl && sh make-shared-library.sh$#)
       (:build-all-cores () #$cd .stash/src/sbcl && sh build-all-cores.sh$#)
       (:update () #$cd .stash/src/sbcl && git pull$#)
       (:install () (funcall #$cd .stash/src/sbcl && INSTALL_ROOT=/usr/local sudo -S sh install.sh$# :input t))
       (:install-pack (tmp)
                      (funcall #$sudo -SE scripts/install-sbcl-pack.sh$# :input t))
       (:dist () #$scripts/dist-sbcl-binary.sh$#)
       (:dist-source () #$scripts/dist-sbcl-source.sh$#))
 (install-quicklisp () #$cd .stash && ../scripts/get.sh https://beta.quicklisp.org/quicklisp.lisp$#
                    #$./scripts/quicklisp-install.sh$#)
 (stumpwm ()
          (:clone (src) (vc:vc-clone ".stash/src/stumpwm" "https://github.com/stumpwm/stumpwm"))
          (:build (clone-stumpwm)
                  #$cd .stash/src/stumpwm && ./autogen.sh && ./configure && make$#)
          (:install () (funcall #$cd .stash/src/stumpwm && sudo -S make install$# :input t))
          (:update () #$cd .stash/src/stumpwm && git pull$#)
          (:dist () #$scripts/dist-stumpwm-binary.sh$#))
 (nyxt () 
       (:clone (src) (vc:vc-clone ".stash/src/nyxt" "https://github.com/atlas-engineer/nyxt"))
       (:build (clone-nyxt)
               #$cd .stash/src/nyxt && git submodule update --init && make all$#))
 (scryer-prolog ()
                (:clone (src) (vc:vc-clone ".stash/src/scryer-prolog" "https://github.com/mthom/scryer-prolog"))
                (:build (clone-scryer-prolog)
                        #$cd .stash/src/scryer-prolog && cargo build --release$#))
 (tree-sitter (src)
              (:clone (src) (vc:vc-clone ".stash/src/tree-sitter" "https://github.com/tree-sitter/tree-sitter"))
              (:build (clone-tree-sitter) #$cd .stash/src/tree-sitter && make libtree-sitter.so$#)
              (:install ()
                        (funcall #$sudo -S ./scripts/install-tree-sitter.sh$# :input t))
              (:install-langs (src) (funcall #$sudo -S ./scripts/tree-sitter-langs.sh$# :input t))
              (:dist (tmp) #$scripts/dist-tree-sitter.sh$#)
              (:dist-langs (tmp) #$scripts/dist-tree-sitter-langs.sh$#))
 (build-linux () #$mkdir -pv .stash/src/linux$#
              #$gpg --export autosigner@ torvalds@ gregkh@ > .stash/src/linux/keyring.gpg$#
              #$./scripts/get-linux.sh $(uname -r | cut -d- -f1) .stash .stash/src/linux/keyring.gpg$#
        #$cd scripts && unxz .stash/src/linux.tar.xz &&
        tar -xvf .stash/src/linux.tar $(uname -r | cut -d- -f1)$#
              #$cd .stash/src/linux && make mrproper -j &&
              zcat /proc/config.gz > .config && yes N | make localmodconfig$#)
(caddy ()
 (:build-xcaddy () #$go install github.com/caddyserver/xcaddy/cmd/xcaddy@latest$#)
 (:build (build-xcaddy-caddy) #$~/go/bin/xcaddy build --output .stash/bin/caddy --with github.com/mholt/caddy-webdav$#)
 (:install () (funcall #$sudo -S cp .stash/bin/caddy /usr/local/bin/caddy$# :input t)))
(rust (src)
 (:clone (src) (vc:vc-clone ".stash/src/rust" "https://github.com/rust-lang/rust"))
 (:build-docs (clone-rust) #$cd .stash/src/rust && ./x doc$#))
(rustls (src)
  (:clone (src) (vc:vc-clone ".stash/src/rustls-ffi" "https://github.com/rustls/rustls-ffi"))
  (:build (clone-rustls)
   #$cd .stash/src/rustls-ffi && cargo capi build --release$#)
  (:install () #$cd .stash/src/rustls-ffi && cargo capi install$#)
  (:dist (tmp) #$scripts/dist-rustls.sh$#))
(slime ()
 (:install () 
  (unless (probe-file #1=(merge-homedir-pathnames ".stash/lisp/slime"))
   (vc:vc-clone #1# "https://github.com/slime/slime"))))
(ublk (src)
 (:clone (src) (vc:vc-clone ".stash/src/ublksrv""https://github.com/ublk-org/ublksrv"))
 (:build (clone-ublk)
       #$cd .stash/src/ublksrv && autoreconf -i && ./configure && make$#)
 (:install () (funcall #$cd .stash/src/ublksrv && sudo -S make install$# :input t)))
 ;; ref: https://github.com/BLAKE3-team/BLAKE3/tree/master/c#building
(blake3 (src)
 (:clone (src) (vc:vc-clone ".stash/src/blake3" "https://github.com/BLAKE3-team/BLAKE3"))
 (:build (clone-blake3)
         #$cd .stash/src/blake3/c && gcc -shared -O3 -o libblake3.so blake3.c blake3_dispatch.c blake3_portable.c \
         blake3_sse2_x86-64_unix.S blake3_sse41_x86-64_unix.S blake3_avx2_x86-64_unix.S \
         blake3_avx512_x86-64_unix.S$#)
 (:install () (funcall #$cd .stash/src/blake3/c && sudo -S cp libblake3.so /usr/local/lib/ && sudo cp blake3.h /usr/local/include/$# :input t))
 (:install-pack (tmp)
                (funcall #$sudo -SE scripts/install-blake3-pack.sh$# :input t))
 (:dist () #$scripts/dist-blake3.sh$#))
 ;; install
 (install-cargo-tools () #$scripts/install-cargo-tools.sh$#)
 (install-rustup () 
  "Install rust - don't forget to source the env file: `. $HOME/.cargo/env`"
  #$curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y$#)
 (install-bettercap () (tools/go:go-install "github.com/bettercap/bettercap@latest"))
 (install-alacritty () (tools/rust:cargo-install :alacritty))
 ;; dist
 (dist (dist-rocksdb dist-sbcl dist-source-sbcl))
 (dist-source (clean) #$cd .. && tar --exclude='.hg' --exclude='#*#' -I 'zstd' -cf infra/infra.tar.zst infra/*$#)
 (dist-home-source () #$tar --exclude='.hg' --exclude='#*#' --exclude='readme.org' \
                   -I 'zstd' -cf home.tar.zst home$#)
 (dist-core-source () 
                   (let ((p *default-pathname-defaults*))
                     (with-project "../core"
                       (sk-run (sk-find "dist-source" *skel-project*))
                       (rename-file "core.tar.zst" (merge-pathnames "core.tar.zst" p)))))
 (dist-org-source () 
                  (let ((p *default-pathname-defaults*))
                    (with-project "../org"
                      (sk-run (sk-find "dist-source" *skel-project*))
                      (rename-file "org.tar.zst" (merge-pathnames "org.tar.zst" p)))))
 (dist-demo-source () #$cd ../ && tar --exclude='*/.hg' --exclude='#*#' -I 'zstd' -cf demo.tar.zst org && mv demo.tar.zst infra/$#)
 (dist-all-source (dist-source dist-home-source dist-core-source dist-demo-source dist-org-source))
 (deploy (dist-all-source) #$mv *.tar.zst $PACKY_HOME/src/$#))
